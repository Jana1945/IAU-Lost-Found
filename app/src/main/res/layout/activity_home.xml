<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Deep blue header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/spacing_24"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/spacing_32">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.App.Title.OnPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/home_subtitle"
                android:textAppearance="@style/TextAppearance.App.Subtitle.OnPrimary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <!-- Row 1: Report Lost / Report Found -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileReportLost"
                    style="@style/App.Tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/tile_height"
                    android:layout_marginEnd="@dimen/spacing_8"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/colorTileBlue">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_16">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_add"
                            android:tint="@color/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_8"
                            android:gravity="center"
                            android:text="@string/home_report_lost"
                            android:textAppearance="@style/TextAppearance.App.CardTitle" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileReportFound"
                    style="@style/App.Tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/tile_height"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/colorTilePeach">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_16">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_add"
                            android:tint="@color/colorLost" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_8"
                            android:gravity="center"
                            android:text="@string/home_report_found"
                            android:textAppearance="@style/TextAppearance.App.CardTitle" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 2: Browse / My Reports -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileBrowse"
                    style="@style/App.Tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/tile_height"
                    android:layout_marginEnd="@dimen/spacing_8"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/colorTileBlue">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_16">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_search"
                            android:tint="@color/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_8"
                            android:gravity="center"
                            android:text="@string/home_browse"
                            android:textAppearance="@style/TextAppearance.App.CardTitle" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileMyReports"
                    style="@style/App.Tile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/tile_height"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/colorTileBlue">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_16">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_person"
                            android:tint="@color/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_8"
                            android:gravity="center"
                            android:text="@string/home_my_reports"
                            android:textAppearance="@style/TextAppearance.App.CardTitle" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Secondary actions -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCollectionPoints"
                style="@style/App.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/home_collection_points"
                app:icon="@drawable/ic_place"
                app:iconGravity="textStart" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettings"
                    style="@style/App.Button.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_settings" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUniversitySite"
                    style="@style/App.Button.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:layout_weight="1"
                    android:text="@string/home_university_site" />
            </LinearLayout>

            <!-- Recent items -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_recent_items"
                    android:textAppearance="@style/TextAppearance.App.Section" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeeAll"
                    style="@style/App.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_see_all" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/recentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/spacing_24"
                android:text="@string/home_empty_state"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textSize="@dimen/text_label"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
